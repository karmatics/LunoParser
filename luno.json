{
  "name": "LunoParser",
  "version": "1.0.0",
  "description": "Luno HTML Container AST Parser & Protocol Library (with interactive diagnostic test suite)",
  "type": "luno-library-app",
  "entrypoint": {
    "file": "LunoTestRunner.js",
    "class": "LunoTestRunner",
    "method": "run"
  },
  "main": [
    "LunoPayloadParser.js",
    "LunoClassPatcher.js",
    "LunoTestRunner.js"
  ],
  "library": [
    "DomBasics.js"
  ],
  "styles": [
    "styles.css"
  ],
  "visibilitySets": {
    "core": [
      "LunoPayloadParser.js",
      "LunoClassPatcher.js"
    ],
    "tests": [
      "LunoPayloadParser.js",
      "LunoClassPatcher.js",
      "LunoTestRunner.js",
      "protocol_test.js"
    ]
  }
}